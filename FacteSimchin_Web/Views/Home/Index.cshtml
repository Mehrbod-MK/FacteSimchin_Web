@{
    ViewData["Title"] = "Home Page";
}

<main class="fsim-bkg align-content-center justify-content-center">
    <div class="container align-content-center justify-content-center text-white fsim-glass-white">
        <div class="row d-flex">
            <div class="d-flex col-xl-auto col-12 align-items-center justify-content-center">
                <img class="img-fluid rounded fsim-anim-flip" src="~/img/mafia_icon.png" width="200px" alt="FacteSimchin Icon" />
            </div>
            <div class="col mt-xl-0 mt-3 align-items-center justify-content-center">
                <div class="container align-content-center justify-content-center">
                    <div class="row">
                        <div class="col-12">
                            <h1>به بازی فکت سیم‌چین خوش آمدید!</h1>
                            <h2 class="display-6 fs-3 mt-3">مافیای کلاسیک، به سبکی نوین...</h2>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <label class="mt-5 fs-5" for="txtGodName">نام خود را به عنوان راوی وارد کنید:</label>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <input id="txtGodName" style="width: 100%;" class="mt-1 text-center" name="txtGodName" type="text"  />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <button id="btnStartNewGame" onclick="godNewGame();" class="btn btn-primary mt-2" style="width: 100%">
                                شروع بازی
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

