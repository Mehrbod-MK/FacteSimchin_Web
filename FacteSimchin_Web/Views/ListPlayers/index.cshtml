@model ListPlayersViewModel
@{
    ViewData["Title"] = "دعوت از بازیکنان";
    string joinLink = $"{Context.Request.Scheme}://{Context.Request.Host}/game/player/joinsession?sessionId={Model.SessionId}";
}

<main class="fsim-bkg align-content-center justify-content-center">
    <div class="container align-content-center justify-content-center text-white fsim-glass-white">
        <div class="row d-flex">
            <div class="d-flex col-xl-auto col-12 align-items-center justify-content-center">
                <img class="img-fluid" src="@Helpers.GenerateQrCodeBase64ImgSrc(joinLink)" width="200px" alt="Join game session QR code" />
            </div>
            <div class="col mt-xl-0 mt-3 align-items-center justify-content-center">
                <div class="container align-content-center justify-content-center">
                    <div class="row">
                        <div class="col-12">
                            <h6>بازیکنان جهت پیوستن به بازی شما، می‌توانند رمزینه مقابل را اسکن کنند، یا از <a href="@joinLink" target="_blank"> این لینک</a> جهت ورود به بازی استفاده کنند.</h6>
                        </div>
                    </div>
                    <div class="row mx-auto overflow-auto" style="max-height: 400px">
                        <table class="table table-striped table-bordered align-middle shadow-lg text-white">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">نام</th>
                                    <th scope="col">عملیات</th>
                                </tr>
                            </thead>
                            <tbody id="tableListPlayersNames" class="text-white">
                                <!--tr>
                                    <th class="text-white" scope="row">SAMPLE ROW</th>
                                    <td class="text-white">Mehrbod MK</td>
                                    <td><button class="btn btn-danger">اخراج</button></td>
                                </tr-->
                            </tbody>
                        </table>
                    </div>
                    <div class="row container align-items-start justify-content-start m-0 p-0">
                        <div class="row">
                            <div class="col-12">
                                <h6 id="lblNumPlayers" class="mb-3">تعداد بازیکنان:  0</h6>
                            </div>
                        </div>
                        <div class="row m-0 p-0">
                            <div class="col-12 m-0 p-0">
                                <button id="btnRefreshPlayersNamesList" class="btn btn-info" onclick="displayPlayersNamesTable('@Model.SessionId', '@Model.GodSecret')">تازه‌سازی لیست</button>
                                <button class="btn btn-danger">بستن جلسه بازی</button>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <button class="btn btn-primary mt-2">انتخاب نقش‌ها</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

