<!DOCTYPE html>
<html lang="@(ViewData["Lang"] ?? "fa")" dir="@(ViewData["Dir"] ?? "rtl")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(!string.IsNullOrEmpty(ViewData["Title"] as string) ? $"{ViewData["Title"]} - " : string.Empty)FacteSimchin Game</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FacteSimchin_Web.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Modal -->
    <div class="modal fade" id="myModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="modalTitle" class="modal-title">@ViewData["ModalTitle"]</h5>
                </div>
                <div id="modalBody" class="modal-body">
                    @(ViewData["ModalContent"] ?? "پیام سیستم")
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">@(ViewData["ModalBtn1Text"] ?? "قبول")</button>
                    @if ((bool?)ViewData["ModalShowBtn2"] == true)
                    {
                        <button type="button" class="btn btn-secondary">@(ViewData["ModalBtn2Text"] ?? "لغو")</button>
                    }
                </div>
            </div>
        </div>
    </div>

    @RenderBody()
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
