@using FacteSimchin_Web.Models.Enums;

@model JoinSessionViewModel

@{
    ViewData["Title"] = "انتخاب نقش‌ها";
}

<main class="fsim-bkg align-content-center justify-content-center">
    <div class="container align-content-center justify-content-center fsim-glass-white">
        <h3 class="text-white mb-3 text-center">لطفاً نقش‌های بازی را انتخاب کنید:</h3>
        <div class="row">
            <h4 class="text-white">نقش‌های پایه:</h4>
            <hr class="text-white" />
            @foreach (KeyValuePair<GameRoles, RoleDefinitionModel> roleDefinition in Definitions.SupportedGameRoles.Where(x => x.Value.IsPlural))
            {
                string cardBorderStyle = "border-", cardTextStyle = "text-";
                switch (roleDefinition.Value.IsMafia)
                {
                    case true:
                        cardBorderStyle += "danger";
                        cardTextStyle += "danger";
                        break;
                    case false:
                        cardBorderStyle += "success";
                        cardTextStyle += "success";
                        break;
                    case null:
                        cardBorderStyle += "warning";
                        cardTextStyle += "warning";
                        break;
                }
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-3">
                    <div class="card h-100 text-center @cardBorderStyle">
                        <img src="@roleDefinition.Value.AvatarUri" class="card-img-top" alt="@roleDefinition.Value.Name" />
                        <div class="card-body @cardTextStyle">
                            <h5 class="card-title mb-4">@roleDefinition.Value.Name</h5>
                            <button id="btnIncrementRole_@(roleDefinition.Key)" onclick="incrementOrDecrementRoleCount('@roleDefinition.Key', true)" class="btn btn-success mb-2">افزایش</button>
                            <button id="btnDecrementRole_@(roleDefinition.Key)" onclick="incrementOrDecrementRoleCount('@roleDefinition.Key', false)" class="btn btn-danger mb-2">کاهش</button>
                            <div id="num_@(roleDefinition.Key)_count_div" class="text-black">
                                <p class="text-black mt-2">تعداد:</p>
                                <p class="text-black" id="lblCount@(roleDefinition.Key)">0</p>
                            </div>
                            <div class="accordin" id="accordin_@roleDefinition.Key">
                                <div class="accordion-item card-text">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@roleDefinition.Key" aria-expanded="false" aria-controls="collapse_@roleDefinition.Key">
                                            نمایش توضیحات نقش
                                        </button>
                                    </h2>
                                    <div id="collapse_@roleDefinition.Key" class="accordion-collapse collapse" data-bs-parent="#accordin_@roleDefinition.Key">
                                        <div class="accordion-body">
                                            @roleDefinition.Value.Description
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <hr class="text-white" />
        </div>
        <div class="row">
            <h4 class="text-danger">نقش‌های ویژه مافیا:</h4>
            <hr class="text-danger" />
            @foreach (KeyValuePair<GameRoles, RoleDefinitionModel> roleDefinition in Definitions.SupportedGameRoles.Where(x => !x.Value.IsPlural && x.Value.IsMafia == true))
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-3">
                    <div class="card h-100 text-center border-danger" id="card_@roleDefinition.Key">
                        <img src="@roleDefinition.Value.AvatarUri" class="card-img-top" alt="@roleDefinition.Value.Name" />
                        <div class="card-body text-danger">
                            <h5 id="roleName_@roleDefinition.Key" class="card-title mb-4">@roleDefinition.Value.Name</h5>
                            <button class="btn btn-primary mb-2" id="btnChooseRole_@roleDefinition.Key" onclick="chooseOrUnchooseRole('@roleDefinition.Key', 'danger')">انتخاب</button>
                            <div class="accordin" id="accordin_@roleDefinition.Key">
                                <div class="accordion-item card-text">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@roleDefinition.Key" aria-expanded="false" aria-controls="collapse_@roleDefinition.Key">
                                            نمایش توضیحات نقش
                                        </button>
                                    </h2>
                                    <div id="collapse_@roleDefinition.Key" class="accordion-collapse collapse" data-bs-parent="#accordin_@roleDefinition.Key">
                                        <div class="accordion-body">
                                            @roleDefinition.Value.Description
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <hr class="text-danger" />
        </div>
        <div class="row">
            <h4 class="text-success">نقش‌های ویژه شهروندی:</h4>
            <hr class="text-success" />
            @foreach (KeyValuePair<GameRoles, RoleDefinitionModel> roleDefinition in Definitions.SupportedGameRoles.Where(x => !x.Value.IsPlural && x.Value.IsMafia == false))
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-3">
                    <div class="card h-100 text-center border-success" id="card_@roleDefinition.Key">
                        <img src="@roleDefinition.Value.AvatarUri" class="card-img-top" alt="@roleDefinition.Value.Name" />
                        <div class="card-body text-success">
                            <h5 id="roleName_@roleDefinition.Key" class="card-title mb-4">@roleDefinition.Value.Name</h5>
                            <button id="btnChooseRole_@roleDefinition.Key" onclick="chooseOrUnchooseRole('@roleDefinition.Key', 'success')" class="btn btn-primary mb-2">انتخاب</button>
                            <div class="accordin" id="accordin_@roleDefinition.Key">
                                <div class="accordion-item card-text">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@roleDefinition.Key" aria-expanded="false" aria-controls="collapse_@roleDefinition.Key">
                                            نمایش توضیحات نقش
                                        </button>
                                    </h2>
                                    <div id="collapse_@roleDefinition.Key" class="accordion-collapse collapse" data-bs-parent="#accordin_@roleDefinition.Key">
                                        <div class="accordion-body">
                                            @roleDefinition.Value.Description
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <hr class="text-success" />
        </div>
        <div class="row">
            <h4 class="text-warning">نقش‌های خنثی:</h4>
            <hr class="text-warning" />
            @foreach (KeyValuePair<GameRoles, RoleDefinitionModel> roleDefinition in Definitions.SupportedGameRoles.Where(x => !x.Value.IsPlural && x.Value.IsMafia == null))
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-3">
                    <div class="card h-100 text-center border-warning" id="card_@roleDefinition.Key">
                        <img src="@roleDefinition.Value.AvatarUri" class="card-img-top" alt="@roleDefinition.Value.Name" />
                        <div class="card-body text-warning">
                            <h5 id="roleName_@roleDefinition.Key" class="card-title mb-4">@roleDefinition.Value.Name</h5>
                            <button id="btnChooseRole_@roleDefinition.Key" onclick="chooseOrUnchooseRole('@roleDefinition.Key', 'warning')" class="btn btn-primary mb-2">انتخاب</button>
                            <div class="accordin" id="accordin_@roleDefinition.Key">
                                <div class="accordion-item card-text">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@roleDefinition.Key" aria-expanded="false" aria-controls="collapse_@roleDefinition.Key">
                                            نمایش توضیحات نقش
                                        </button>
                                    </h2>
                                    <div id="collapse_@roleDefinition.Key" class="accordion-collapse collapse" data-bs-parent="#accordin_@roleDefinition.Key">
                                        <div class="accordion-body">
                                            @roleDefinition.Value.Description
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <hr class="text-warning" />
        </div>
        <div class="row">
            <h5 class="text-white">تعداد کل نقش‌های انتخاب‌شده:  0</h5>
            <h5 class="text-white">تعداد کل بازیکنان:  0</h5>
            <p>تعداد کل نقش‌ها باید با تعداد بازیکنان برابر باشد، تا همگی بتوانند نقش بگیرند.</p>
        </div>
        <hr class="text-white" />
        <div class="row">
            <button class="btn btn-primary">پخش‌کردن نقش‌ها</button>
        </div>
    </div>
</main>

